{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KTAIorg/kt-signal-connector/schemas/runtime-manifest-v1.schema.json",
  "title": "KT Signal Connector runtime manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "bundleId",
    "createdAtUnixMs",
    "platform",
    "components",
    "licenses"
  ],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "bundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "createdAtUnixMs": { "type": "integer", "minimum": 0 },
    "platform": {
      "enum": ["macos-arm64", "macos-x64", "windows-x64", "unknown"]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector", "signalCli", "jre"],
      "properties": {
        "connector": { "$ref": "#/$defs/component" },
        "signalCli": { "$ref": "#/$defs/component" },
        "jre": { "$ref": "#/$defs/component" }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "spdx", "path"],
        "properties": {
          "component": { "type": "string" },
          "spdx": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "sbomPath": { "type": "string" },
    "sourceArchive": { "$ref": "#/$defs/artifact" },
    "buildRecordPath": { "type": "string" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {
          "enum": ["unsigned-local", "sha256-only", "minisign", "cosign"]
        },
        "value": { "type": "string" }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
