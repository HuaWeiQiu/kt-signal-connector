{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KTAIorg/kt-signal-connector/schemas/connector-api-v1.schema.json",
  "title": "KT Signal Connector API v1 host frame",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "apiVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proxyGroupId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Proxy group identifier (ADR 0001, Phase 4). 'default' is the reserved, always-present group; additional groups are defined by the trusted launcher at connector spawn and are never created over IPC. An omitted proxyGroup means 'default'."
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "requestId", "method", "params"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": {
          "enum": [
            "handshake",
            "runtime.status",
            "runtime.start",
            "runtime.stop",
            "accounts.list",
            "accounts.deleteLocalData",
            "link.start",
            "link.finish",
            "link.cancel",
            "conversations.list",
            "messages.list",
            "messages.getText",
            "messages.sendText",
            "messages.remoteDelete",
            "contacts.sync",
            "contacts.list"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "handshake" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/handshakeParams" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": ["runtime.status", "runtime.start", "runtime.stop", "accounts.list"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "accounts.deleteLocalData" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/accountDeleteLocalDataParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "link.start" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/linkStartParams" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": { "enum": ["link.finish", "link.cancel"] }
            },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/linkSessionParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "conversations.list" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/conversationsListParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "messages.list" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/messagesListParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "messages.sendText" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/messagesSendTextParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "messages.getText" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/messageGetTextParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "messages.remoteDelete" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/messagesRemoteDeleteParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "contacts.sync" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/contactsSyncParams" }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "contacts.list" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/contactsListParams" }
            }
          }
        }
      ]
    },
    "handshakeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNonce", "proof"],
      "properties": {
        "clientNonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proof": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "linkStartParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceName"],
      "properties": {
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "proxyGroup": {
          "$ref": "#/$defs/proxyGroupId",
          "description": "Optional target proxy group for the account being linked; fixed for the life of the link once link.finish succeeds. An unknown group fails with PROXY_GROUP_NOT_FOUND. A pre-Phase-4 connector rejects this field with INVALID_REQUEST (deny_unknown_fields), so hosts must feature-detect via runtime.status first."
        }
      }
    },
    "accountDeleteLocalDataParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId"],
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" },
        "operationId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "linkSessionParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linkSessionId"],
      "properties": {
        "linkSessionId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "conversationsListParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "limit"],
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" },
        "cursor": { "type": "string", "maxLength": 256 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "messagesListParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "conversationId", "limit"],
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" },
        "conversationId": { "$ref": "#/$defs/opaqueId" },
        "before": { "type": "string", "maxLength": 256 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "messagesSendTextParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "text", "clientRequestId"],
      "description": "Exactly one addressing form must be set: conversationId, or kind+peerKey (peerTitle optional).",
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" },
        "conversationId": { "$ref": "#/$defs/opaqueId" },
        "kind": {
          "type": "string",
          "enum": ["contact", "direct", "group"],
          "description": "Peer target kind; 'contact' and 'direct' both address a direct chat."
        },
        "peerKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Recipient number/uuid for direct chats, group id for groups."
        },
        "peerTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional display title used when the peer send creates a new conversation."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "Non-empty text; the service authoritatively enforces at most 65536 UTF-8 bytes."
        },
        "clientRequestId": { "$ref": "#/$defs/opaqueId" },
        "quoteMessageId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "contactsSyncParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId"],
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "contactsListParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "limit"],
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional case-insensitive substring filter over title and peerKey; read-only over the local cache."
        },
        "cursor": { "type": "string", "maxLength": 256 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "messageGetTextParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "conversationId", "messageId"],
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" },
        "conversationId": { "$ref": "#/$defs/opaqueId" },
        "messageId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "messagesRemoteDeleteParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "conversationId", "messageId"],
      "description": "Remotely delete (Delete for everyone) one message the linked account itself sent. Only a local outgoing row in the terminal state 'sent' qualifies: its sentAt is the upstream Signal timestamp addressed by the delete; pending/failed/unknown rows carry no protocol identity and answer MESSAGE_NOT_FOUND. Best effort upstream semantics (24h window, quoted/replying messages are not removed). Targeting is by conversationId only — the target must already exist in the local history. The result is {status: 'deleted'} when signal-cli confirmed the delete, or {status: 'unknown'} when the outcome of the mutating upstream call cannot be determined; 'unknown' is never retried automatically by the connector (host may explicitly re-send with a fresh requestId and the same operationId). operationId is an optional host correlation id; the connector validates its shape but does not persist it.",
      "properties": {
        "accountId": { "$ref": "#/$defs/opaqueId" },
        "conversationId": { "$ref": "#/$defs/opaqueId" },
        "messageId": { "$ref": "#/$defs/opaqueId" },
        "operationId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "requestId"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [
        {
          "required": ["result"],
          "not": { "required": ["error"] }
        },
        {
          "required": ["error"],
          "not": { "required": ["result"] }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "event", "data"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "event": {
          "enum": [
            "runtime.challenge",
            "runtime.stateChanged",
            "runtime.protocolWarning",
            "runtime.storageChanged",
            "runtime.resourcePressure",
            "proxyGroup.stateChanged",
            "account.changed",
            "conversation.changed",
            "message.upserted",
            "message.statusChanged"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "event": { "const": "runtime.resourcePressure" } },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "pid", "rssBytes", "groupId"],
                "properties": {
                  "state": { "enum": ["elevated", "recovered"] },
                  "pid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                  "rssBytes": { "type": "integer", "minimum": 0 },
                  "groupId": {
                    "$ref": "#/$defs/proxyGroupId",
                    "description": "Group whose engine sampled the pressure transition; 'default' in single-group deployments (ADR 0001)."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "event": { "const": "proxyGroup.stateChanged" } },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["groupId", "state", "resourcePressure"],
                "description": "One proxy group's engine transition (ADR 0001). runtime.stateChanged keeps carrying the top-level aggregate; this event carries per-group detail.",
                "properties": {
                  "groupId": { "$ref": "#/$defs/proxyGroupId" },
                  "state": { "enum": ["running", "stopped", "exited", "faulted"] },
                  "pid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                  "rssBytes": { "type": "integer", "minimum": 0 },
                  "resourcePressure": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "event": { "const": "message.statusChanged" } },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["accountId", "messageId", "status"],
                "properties": {
                  "accountId": { "$ref": "#/$defs/opaqueId" },
                  "messageId": { "$ref": "#/$defs/opaqueId" },
                  "status": {
                    "enum": ["sent", "unknown", "failed"],
                    "description": "Terminal state one outgoing message transitioned to; emitted only on a real transition (pending -> sent/unknown/failed), never replayed."
                  }
                }
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "AUTHENTICATION_FAILED",
            "METHOD_NOT_ALLOWED",
            "CAPABILITY_UNAVAILABLE",
            "RUNTIME_ALREADY_RUNNING",
            "RUNTIME_NOT_RUNNING",
            "RUNTIME_START_FAILED",
            "RUNTIME_STOP_FAILED",
            "LINK_IN_PROGRESS",
            "LINK_NOT_FOUND",
            "LINK_EXPIRED",
            "LINK_CANCELLED",
            "ACCOUNT_NOT_FOUND",
            "CONVERSATION_NOT_FOUND",
            "MESSAGE_NOT_FOUND",
            "PROXY_GROUP_NOT_FOUND",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_EXITED",
            "UPSTREAM_PROTOCOL_ERROR",
            "UPSTREAM_ERROR",
            "ACCOUNT_DELETE_OUTCOME_UNKNOWN",
            "LINK_OUTCOME_UNKNOWN",
            "SEND_OUTCOME_UNKNOWN",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
