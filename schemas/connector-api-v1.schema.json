{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KTAIorg/kt-signal-connector/schemas/connector-api-v1.schema.json",
  "title": "KT Signal Connector API v1 host frame",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "apiVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "requestId", "method", "params"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": {
          "enum": [
            "handshake",
            "runtime.status",
            "runtime.start",
            "runtime.stop",
            "accounts.list",
            "link.start",
            "link.finish",
            "link.cancel",
            "conversations.list",
            "messages.list",
            "messages.sendText"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "handshake" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "$ref": "#/$defs/handshakeParams" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": ["runtime.status", "runtime.start", "runtime.stop"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "handshakeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNonce", "proof"],
      "properties": {
        "clientNonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proof": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "requestId"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [
        {
          "required": ["result"],
          "not": { "required": ["error"] }
        },
        {
          "required": ["error"],
          "not": { "required": ["result"] }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "event", "data"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "event": {
          "enum": [
            "runtime.challenge",
            "runtime.stateChanged",
            "runtime.protocolWarning",
            "signal.receive"
          ]
        },
        "data": {
          "type": "object"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "AUTHENTICATION_FAILED",
            "METHOD_NOT_ALLOWED",
            "CAPABILITY_UNAVAILABLE",
            "RUNTIME_ALREADY_RUNNING",
            "RUNTIME_NOT_RUNNING",
            "RUNTIME_START_FAILED",
            "RUNTIME_STOP_FAILED",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_EXITED",
            "UPSTREAM_PROTOCOL_ERROR",
            "SEND_OUTCOME_UNKNOWN",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
